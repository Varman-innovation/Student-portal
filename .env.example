# Demo mode works without Supabase and stores data in the running process.
DEMO_MODE=true
ALLOW_DEMO_OTP=true
DEMO_OTP_CODE=0000

# Local-only admin defaults. Production must override all three values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Add these after creating a Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional initial webinar override.
DEFAULT_MEETING_URL=https://meet.google.com/
